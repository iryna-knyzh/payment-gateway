# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Fail on deprecations triggered by our own code; hide noise from vendor packages.
SYMFONY_DEPRECATIONS_HELPER="max[self]=0&quiet[]=direct&quiet[]=indirect&quiet[]=other"

# Tests run on SQLite: no external database needed.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

FAKEBANK_BASE_URI=https://fakebank.test/api/
FAKEBANK_API_KEY=test_api_key
FAKEBANK_WEBHOOK_SECRET=test_fakebank_webhook_secret
QUICKPAY_BASE_URI=https://quickpay.test/gw/
QUICKPAY_MERCHANT_ID=test_merchant
QUICKPAY_SECRET=test_quickpay_secret
APP_PUBLIC_URL=https://gateway.test
